# ── Supabase ─────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then run supabase/schema.sql
# in the SQL editor. Get these from Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the browser

# ── Stripe (test mode first) ────────────────────────────────────────────
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# After deploying, create a webhook endpoint in Stripe pointing to
# https://yourdomain.com/api/stripe-webhook, listening for:
#   checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# then paste its signing secret here:
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── AI provider (optional for now) ──────────────────────────────────────
# Leave unset during development — the app uses a rule-based mock reading
# engine that already follows the full reading structure. Add this when
# you're ready to connect a real model (see lib/ai.ts).
ANTHROPIC_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:3000
